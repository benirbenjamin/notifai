<%- include('../partials/admin-header', { title: 'Notifications Management' }) %>

<div class="admin-container">
    <%- include('../partials/admin-sidebar', { page: 'notifications' }) %>
    
    <main class="admin-main">
        <!-- Header -->
        <div class="admin-header">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">Notifications Management</h1>
                    <p class="text-muted mb-0">Monitor and manage system notifications and reminders</p>
                </div>
                <div class="admin-actions">
                    <div class="btn-group me-2">
                        <button class="btn btn-outline-secondary" onclick="filterNotifications('all')">All</button>
                        <button class="btn btn-outline-secondary" onclick="filterNotifications('email')">Email</button>
                        <button class="btn btn-outline-secondary" onclick="filterNotifications('push')">Push</button>
                        <button class="btn btn-outline-secondary" onclick="filterNotifications('sent')">Sent</button>
                        <button class="btn btn-outline-secondary" onclick="filterNotifications('pending')">Pending</button>
                    </div>
                    <button class="btn btn-primary" onclick="sendPendingNotifications()">
                        <i class="bi bi-send me-1"></i>Send Pending
                    </button>
                </div>
            </div>
        </div>

        <!-- Notifications Stats -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-bell fs-2 mb-2"></i>
                        <h3 class="mb-0"><%= notifications.length %></h3>
                        <small>Total Notifications</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-check-circle fs-2 mb-2"></i>
                        <h3 class="mb-0"><%= notifications.filter(n => n.is_sent).length %></h3>
                        <small>Sent</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-clock fs-2 mb-2"></i>
                        <h3 class="mb-0"><%= notifications.filter(n => !n.is_sent).length %></h3>
                        <small>Pending</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-envelope fs-2 mb-2"></i>
                        <h3 class="mb-0"><%= notifications.filter(n => n.reminder_type === 'email').length %></h3>
                        <small>Email Notifications</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notifications Table -->
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-bell me-2"></i>All Notifications
                        </h5>
                    </div>
                    <div class="col-auto">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Search notifications..." id="searchInput">
                            <button class="btn btn-outline-secondary" type="button">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <% if (notifications && notifications.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover" id="notificationsTable">
                            <thead>
                                <tr>
                                    <th>Activity</th>
                                    <th>User</th>
                                    <th>Type</th>
                                    <th>Scheduled Date</th>
                                    <th>Status</th>
                                    <th>Sent Date</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% notifications.forEach(notification => { %>
                                    <tr data-type="<%= notification.reminder_type %>" data-status="<%= notification.is_sent ? 'sent' : 'pending' %>">
                                        <td>
                                            <div class="fw-medium"><%= notification.activity_title %></div>
                                            <small class="text-muted">Activity ID: <%= notification.activity_id %></small>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                                    <i class="bi bi-person text-white small"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-medium"><%= notification.first_name %> <%= notification.last_name %></div>
                                                    <small class="text-muted"><%= notification.email %></small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-<%= notification.reminder_type === 'email' ? 'primary' : 'info' %>">
                                                <i class="bi bi-<%= notification.reminder_type === 'email' ? 'envelope' : 'bell' %> me-1"></i>
                                                <%= notification.reminder_type.charAt(0).toUpperCase() + notification.reminder_type.slice(1) %>
                                            </span>
                                        </td>
                                        <td>
                                            <% const reminderDate = new Date(notification.reminder_date); %>
                                            <% const now = new Date(); %>
                                            <% const isPast = reminderDate < now; %>
                                            <span class="<%= isPast && !notification.is_sent ? 'text-danger' : 'text-muted' %>">
                                                <%= reminderDate.toLocaleDateString() %>
                                                <br><small><%= reminderDate.toLocaleTimeString() %></small>
                                            </span>
                                            <% if (isPast && !notification.is_sent) { %>
                                                <br><small class="text-danger">Overdue</small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-<%= notification.is_sent ? 'success' : 'warning' %>">
                                                <i class="bi bi-<%= notification.is_sent ? 'check-circle' : 'clock' %> me-1"></i>
                                                <%= notification.is_sent ? 'Sent' : 'Pending' %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (notification.sent_at) { %>
                                                <%= new Date(notification.sent_at).toLocaleDateString() %>
                                                <br><small class="text-muted"><%= new Date(notification.sent_at).toLocaleTimeString() %></small>
                                            <% } else { %>
                                                <span class="text-muted">Not sent</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <%= new Date(notification.created_at).toLocaleDateString() %>
                                            <br><small class="text-muted"><%= new Date(notification.created_at).toLocaleTimeString() %></small>
                                        </td>
                                        <td>
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                                    <i class="bi bi-three-dots"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <% if (!notification.is_sent) { %>
                                                        <li><a class="dropdown-item" href="#" onclick="sendNotification('<%= notification.id %>')">
                                                            <i class="bi bi-send me-2"></i>Send Now
                                                        </a></li>
                                                    <% } %>
                                                    <li><a class="dropdown-item" href="#" onclick="rescheduleNotification('<%= notification.id %>')">
                                                        <i class="bi bi-calendar me-2"></i>Reschedule
                                                    </a></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><a class="dropdown-item text-danger" href="#" onclick="deleteNotification('<%= notification.id %>')">
                                                        <i class="bi bi-trash me-2"></i>Delete
                                                    </a></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-bell fs-1 text-muted"></i>
                        <h5 class="text-muted mt-3">No Notifications</h5>
                        <p class="text-muted">No notifications have been scheduled yet.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<!-- Reschedule Modal -->
<div class="modal fade" id="rescheduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reschedule Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="rescheduleForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newReminderDate" class="form-label">New Reminder Date & Time</label>
                        <input type="datetime-local" class="form-control" id="newReminderDate" name="reminderDate" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Reschedule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let currentNotificationId = null;

// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const tableRows = document.querySelectorAll('#notificationsTable tbody tr');
    
    tableRows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(searchTerm) ? '' : 'none';
    });
});

// Filter notifications
function filterNotifications(type) {
    const tableRows = document.querySelectorAll('#notificationsTable tbody tr');
    const buttons = document.querySelectorAll('.btn-group button');
    
    // Update button states
    buttons.forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
    
    tableRows.forEach(row => {
        const rowType = row.getAttribute('data-type');
        const rowStatus = row.getAttribute('data-status');
        
        let show = false;
        switch(type) {
            case 'all':
                show = true;
                break;
            case 'email':
            case 'push':
                show = rowType === type;
                break;
            case 'sent':
            case 'pending':
                show = rowStatus === type;
                break;
        }
        
        row.style.display = show ? '' : 'none';
    });
}

// Send pending notifications
function sendPendingNotifications() {
    if (confirm('Are you sure you want to send all pending notifications?')) {
        fetch('/admin/notifications/send-pending', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(`Successfully sent ${data.count} notifications`);
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            alert('Error sending notifications: ' + error.message);
        });
    }
}

// Send individual notification
function sendNotification(notificationId) {
    if (confirm('Are you sure you want to send this notification now?')) {
        fetch(`/admin/notifications/${notificationId}/send`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            alert('Error sending notification: ' + error.message);
        });
    }
}

// Reschedule notification
function rescheduleNotification(notificationId) {
    currentNotificationId = notificationId;
    const modal = new bootstrap.Modal(document.getElementById('rescheduleModal'));
    modal.show();
}

// Handle reschedule form
document.getElementById('rescheduleForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const reminderDate = formData.get('reminderDate');
    
    if (currentNotificationId) {
        fetch(`/admin/notifications/${currentNotificationId}/reschedule`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                reminderDate: reminderDate
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            alert('Error rescheduling notification: ' + error.message);
        });
    }
});

// Delete notification
function deleteNotification(notificationId) {
    if (confirm('Are you sure you want to delete this notification? This action cannot be undone.')) {
        fetch(`/admin/notifications/${notificationId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            alert('Error deleting notification: ' + error.message);
        });
    }
}
</script>

<%- include('../partials/admin-footer') %>
