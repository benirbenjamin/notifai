<%- include('../partials/admin-header', { title: 'Plans Management' }) %>

<div class="admin-container">
    <%- include('../partials/admin-sidebar', { page: 'plans' }) %>
    
    <main class="admin-main">
        <!-- Header -->
        <div class="admin-header">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">Plans & Pricing</h1>
                    <p class="text-muted mb-0">Manage subscription plans and pricing</p>
                </div>
                <div class="admin-actions">
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPlanModal">
                        <i class="bi bi-plus-circle me-1"></i>Create Plan
                    </button>
                </div>
            </div>
        </div>

        <!-- Plans Summary -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-layers fs-2 mb-2"></i>
                        <h3 class="mb-0"><%= plans ? plans.filter(p => p.is_active).length : 0 %></h3>
                        <small>Active Plans</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-gift fs-2 mb-2"></i>
                        <h3 class="mb-0"><%= plans ? plans.filter(p => p.price == 0).length : 0 %></h3>
                        <small>Free Plans</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-star fs-2 mb-2"></i>
                        <h3 class="mb-0"><%= plans ? plans.filter(p => p.is_lifetime).length : 0 %></h3>
                        <small>Lifetime Plans</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-credit-card fs-2 mb-2"></i>
                        <h3 class="mb-0"><%= plans ? plans.filter(p => p.price > 0).length : 0 %></h3>
                        <small>Paid Plans</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Current Plan Structure Notice -->
        <div class="alert alert-info mb-4">
            <div class="d-flex align-items-center">
                <i class="bi bi-info-circle fs-4 me-3"></i>
                <div>
                    <h6 class="mb-1">Current Plan Structure</h6>
                    <p class="mb-0">
                        <strong>Free Plan:</strong> 10 activities with full feature access • 
                        <strong>Premium Plan:</strong> Unlimited activities for $10 one-time payment (lifetime access)
                    </p>
                </div>
            </div>
        </div>

        <!-- Plans Grid -->
        <div class="row g-4">
            <% if (plans && plans.length > 0) { %>
                <% plans.forEach(plan => { %>
                    <div class="col-lg-4 col-md-6">
                        <div class="card plan-card <%= plan.is_active ? '' : 'inactive' %>">
                            <div class="card-header">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="card-title mb-0">
                                        <%= plan.name %>
                                        <% if (!plan.is_active) { %>
                                            <span class="badge bg-secondary ms-2">Inactive</span>
                                        <% } %>
                                    </h5>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#" onclick="editPlan(<%= plan.id %>)">
                                                <i class="bi bi-pencil me-2"></i>Edit
                                            </a></li>
                                            <li><a class="dropdown-item" href="#" onclick="togglePlan(<%= plan.id %>, <%= !plan.is_active %>)">
                                                <i class="bi bi-<%= plan.is_active ? 'pause' : 'play' %> me-2"></i>
                                                <%= plan.is_active ? 'Deactivate' : 'Activate' %>
                                            </a></li>
                                            <% if (plan.name !== 'Free' && plan.name !== 'Unlimited Premium') { %>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item text-danger" href="#" onclick="deletePlan(<%= plan.id %>)">
                                                    <i class="bi bi-trash me-2"></i>Delete
                                                </a></li>
                                            <% } %>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="plan-price">
                                    <h2 class="h1 fw-bold">
                                        <% if (plan.price == 0) { %>
                                            Free
                                        <% } else { %>
                                            $<%= plan.price %>
                                            <% if (plan.is_lifetime) { %>
                                                <small class="text-muted fs-6">one-time</small>
                                            <% } else { %>
                                                <small class="text-muted fs-6">/month</small>
                                            <% } %>
                                        <% } %>
                                    </h2>
                                </div>
                                
                                <p class="text-muted mb-4"><%= plan.description %></p>
                                
                                <!-- Plan Features -->
                                <div class="plan-features mb-4">
                                    <div class="feature-item">
                                        <i class="bi bi-check-circle text-success me-2"></i>
                                        <span>
                                            <%= plan.max_activities >= 999999 ? 'Unlimited' : plan.max_activities %> Activities
                                        </span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="bi bi-<%= plan.has_push_notifications ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
                                        <span>Push Notifications</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="bi bi-<%= plan.has_attachments ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
                                        <span>File Attachments</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="bi bi-<%= plan.has_recurring_tasks ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
                                        <span>Recurring Tasks</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="bi bi-<%= plan.has_categories ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
                                        <span>Categories & Tags</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="bi bi-<%= plan.has_priority_levels ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
                                        <span>Priority Levels</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="bi bi-<%= plan.has_advanced_progress ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
                                        <span>Advanced Progress Tracking</span>
                                    </div>
                                </div>
                                
                                <!-- Plan Stats -->
                                <div class="plan-stats">
                                    <div class="row text-center">
                                        <div class="col-6">
                                            <div class="stat-number"><%= plan.user_count || 0 %></div>
                                            <small class="text-muted">Users</small>
                                        </div>
                                        <div class="col-6">
                                            <div class="stat-number">$<%= (plan.revenue || 0).toFixed(2) %></div>
                                            <small class="text-muted">Revenue</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12">
                    <div class="text-center py-5">
                        <i class="bi bi-gem display-4 text-muted"></i>
                        <h5 class="mt-3">No plans available</h5>
                        <p class="text-muted">Create your first subscription plan to get started.</p>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPlanModal">
                            <i class="bi bi-plus-circle me-1"></i>Create Plan
                        </button>
                    </div>
                </div>
            <% } %>
        </div>
    </main>
</div>

<!-- Create Plan Modal -->
<div class="modal fade" id="createPlanModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Plan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createPlanForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="planName" class="form-label">Plan Name</label>
                                <input type="text" class="form-control" id="planName" name="name" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="planPrice" class="form-label">Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="planPrice" name="price" step="0.01" required>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="planDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="planDescription" name="description" rows="3"></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="maxActivities" class="form-label">Max Activities</label>
                                <input type="number" class="form-control" id="maxActivities" name="max_activities" min="-1">
                                <small class="text-muted">Use -1 for unlimited</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="billingCycle" class="form-label">Billing Cycle</label>
                                <select class="form-select" id="billingCycle" name="billing_cycle">
                                    <option value="month">Monthly</option>
                                    <option value="year">Yearly</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Features -->
                    <div class="mb-3">
                        <label class="form-label">Features</label>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="emailNotifications" name="email_notifications">
                                    <label class="form-check-label" for="emailNotifications">Email Notifications</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="pushNotifications" name="push_notifications">
                                    <label class="form-check-label" for="pushNotifications">Push Notifications</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="fileAttachments" name="file_attachments">
                                    <label class="form-check-label" for="fileAttachments">File Attachments</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="recurringTasks" name="recurring_tasks">
                                    <label class="form-check-label" for="recurringTasks">Recurring Tasks</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="prioritySupport" name="priority_support">
                                    <label class="form-check-label" for="prioritySupport">Priority Support</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isActive" name="is_active" checked>
                                    <label class="form-check-label" for="isActive">Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function editPlan(planId) {
    // Implementation for editing plan
    console.log('Edit plan:', planId);
}

function togglePlan(planId, activate) {
    // Implementation for toggling plan status
    console.log('Toggle plan:', planId, activate);
}

function deletePlan(planId) {
    if (confirm('Are you sure you want to delete this plan? This action cannot be undone.')) {
        // Implementation for deleting plan
        console.log('Delete plan:', planId);
    }
}

// Handle create plan form
document.getElementById('createPlanForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    // Implementation for creating plan
    console.log('Create plan form submitted');
});
</script>

<%- include('../partials/admin-footer') %>
