<%- include('../partials/header') %>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Task Limit Warning for Free Users -->
            <% if (user && user.plan && (user.plan.plan_name === 'Free' || user.plan.name === 'Free')) { %>
                <% 
                    const activityCount = user.activityCount || 0;
                    const remaining = 10 - activityCount;
                %>
                <% if (remaining <= 0) { %>
                    <div class="alert alert-danger mb-4" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
                            <div>
                                <h5 class="alert-heading mb-1">Activity Limit Reached</h5>
                                <p class="mb-2">You've reached your limit of 10 activities on the Free plan. To create more activities, upgrade to Lifetime Premium.</p>
                                <a href="/payments/plans" class="btn btn-primary btn-sm">
                                    <i class="bi bi-gem me-2"></i>Upgrade to Lifetime Premium - $10
                                </a>
                            </div>
                        </div>
                    </div>
                <% } else if (remaining <= 2) { %>
                    <div class="alert alert-warning mb-4" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle me-3 fs-5"></i>
                            <div>
                                <h6 class="alert-heading mb-1">Almost at your limit!</h6>
                                <p class="mb-2">You have <%= remaining %> activities remaining on your Free plan. Upgrade to get unlimited activities.</p>
                                <a href="/payments/plans" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-gem me-2"></i>Get Lifetime Access - $10
                                </a>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="alert alert-info mb-4" role="alert">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Free Plan:</strong> <%= activityCount %>/10 activities used
                            </div>
                            <a href="/payments/plans" class="btn btn-outline-primary btn-sm">
                                Upgrade to Lifetime - $10
                            </a>
                        </div>
                    </div>
                <% } %>
            <% } %>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">Create Activity</h1>
                <a href="/activities" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to Activities
                </a>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Activity Details</h5>
                        </div>
                        <div class="card-body">
                            <form action="/activities" method="POST">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="mb-3">
                                            <label for="title" class="form-label">Title *</label>
                                            <input type="text" class="form-control" id="title" name="title" 
                                                   value="<%= typeof formData !== 'undefined' ? formData.title || '' : '' %>" required>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label for="type" class="form-label">Type *</label>
                                            <select class="form-select" id="type" name="type" required>
                                                <option value="">Select Type</option>
                                                <option value="general" <%= typeof formData !== 'undefined' && formData.type === 'general' ? 'selected' : '' %>>General</option>
                                                <option value="payment" <%= typeof formData !== 'undefined' && formData.type === 'payment' ? 'selected' : '' %>>Payment</option>
                                                <option value="purchase" <%= typeof formData !== 'undefined' && formData.type === 'purchase' ? 'selected' : '' %>>Purchase</option>
                                                <option value="recurring" <%= typeof formData !== 'undefined' && formData.type === 'recurring' ? 'selected' : '' %>>Recurring</option>
                                                <option value="timed" <%= typeof formData !== 'undefined' && formData.type === 'timed' ? 'selected' : '' %>>Timed Task</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="description" class="form-label">Description</label>
                                    <textarea class="form-control" id="description" name="description" rows="3"><%= typeof formData !== 'undefined' ? formData.description || '' : '' %></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="category" class="form-label">Category</label>
                                            <select class="form-select" id="category" name="category">
                                                <option value="">Select a category...</option>
                                                <optgroup label="Work & Business">
                                                    <option value="Work" <%= typeof formData !== 'undefined' && formData.category === 'Work' ? 'selected' : '' %>>Work</option>
                                                    <option value="Business" <%= typeof formData !== 'undefined' && formData.category === 'Business' ? 'selected' : '' %>>Business</option>
                                                    <option value="Meetings" <%= typeof formData !== 'undefined' && formData.category === 'Meetings' ? 'selected' : '' %>>Meetings</option>
                                                    <option value="Projects" <%= typeof formData !== 'undefined' && formData.category === 'Projects' ? 'selected' : '' %>>Projects</option>
                                                    <option value="Career" <%= typeof formData !== 'undefined' && formData.category === 'Career' ? 'selected' : '' %>>Career</option>
                                                </optgroup>
                                                <optgroup label="Personal Life">
                                                    <option value="Personal" <%= typeof formData !== 'undefined' && formData.category === 'Personal' ? 'selected' : '' %>>Personal</option>
                                                    <option value="Family" <%= typeof formData !== 'undefined' && formData.category === 'Family' ? 'selected' : '' %>>Family</option>
                                                    <option value="Friends" <%= typeof formData !== 'undefined' && formData.category === 'Friends' ? 'selected' : '' %>>Friends</option>
                                                    <option value="Social" <%= typeof formData !== 'undefined' && formData.category === 'Social' ? 'selected' : '' %>>Social</option>
                                                    <option value="Relationships" <%= typeof formData !== 'undefined' && formData.category === 'Relationships' ? 'selected' : '' %>>Relationships</option>
                                                </optgroup>
                                                <optgroup label="Health & Wellness">
                                                    <option value="Health" <%= typeof formData !== 'undefined' && formData.category === 'Health' ? 'selected' : '' %>>Health</option>
                                                    <option value="Exercise" <%= typeof formData !== 'undefined' && formData.category === 'Exercise' ? 'selected' : '' %>>Exercise</option>
                                                    <option value="Fitness" <%= typeof formData !== 'undefined' && formData.category === 'Fitness' ? 'selected' : '' %>>Fitness</option>
                                                    <option value="Medical" <%= typeof formData !== 'undefined' && formData.category === 'Medical' ? 'selected' : '' %>>Medical</option>
                                                    <option value="Mental Health" <%= typeof formData !== 'undefined' && formData.category === 'Mental Health' ? 'selected' : '' %>>Mental Health</option>
                                                </optgroup>
                                                <optgroup label="Financial">
                                                    <option value="Finance" <%= typeof formData !== 'undefined' && formData.category === 'Finance' ? 'selected' : '' %>>Finance</option>
                                                    <option value="Banking" <%= typeof formData !== 'undefined' && formData.category === 'Banking' ? 'selected' : '' %>>Banking</option>
                                                    <option value="Investments" <%= typeof formData !== 'undefined' && formData.category === 'Investments' ? 'selected' : '' %>>Investments</option>
                                                    <option value="Bills" <%= typeof formData !== 'undefined' && formData.category === 'Bills' ? 'selected' : '' %>>Bills</option>
                                                    <option value="Taxes" <%= typeof formData !== 'undefined' && formData.category === 'Taxes' ? 'selected' : '' %>>Taxes</option>
                                                </optgroup>
                                                <optgroup label="Learning & Development">
                                                    <option value="Education" <%= typeof formData !== 'undefined' && formData.category === 'Education' ? 'selected' : '' %>>Education</option>
                                                    <option value="Learning" <%= typeof formData !== 'undefined' && formData.category === 'Learning' ? 'selected' : '' %>>Learning</option>
                                                    <option value="Courses" <%= typeof formData !== 'undefined' && formData.category === 'Courses' ? 'selected' : '' %>>Courses</option>
                                                    <option value="Skills" <%= typeof formData !== 'undefined' && formData.category === 'Skills' ? 'selected' : '' %>>Skills</option>
                                                    <option value="Reading" <%= typeof formData !== 'undefined' && formData.category === 'Reading' ? 'selected' : '' %>>Reading</option>
                                                </optgroup>
                                                <optgroup label="Daily Tasks">
                                                    <option value="Shopping" <%= typeof formData !== 'undefined' && formData.category === 'Shopping' ? 'selected' : '' %>>Shopping</option>
                                                    <option value="Errands" <%= typeof formData !== 'undefined' && formData.category === 'Errands' ? 'selected' : '' %>>Errands</option>
                                                    <option value="Household" <%= typeof formData !== 'undefined' && formData.category === 'Household' ? 'selected' : '' %>>Household</option>
                                                    <option value="Chores" <%= typeof formData !== 'undefined' && formData.category === 'Chores' ? 'selected' : '' %>>Chores</option>
                                                    <option value="Maintenance" <%= typeof formData !== 'undefined' && formData.category === 'Maintenance' ? 'selected' : '' %>>Maintenance</option>
                                                </optgroup>
                                                <optgroup label="Travel & Transportation">
                                                    <option value="Travel" <%= typeof formData !== 'undefined' && formData.category === 'Travel' ? 'selected' : '' %>>Travel</option>
                                                    <option value="Transportation" <%= typeof formData !== 'undefined' && formData.category === 'Transportation' ? 'selected' : '' %>>Transportation</option>
                                                    <option value="Vacation" <%= typeof formData !== 'undefined' && formData.category === 'Vacation' ? 'selected' : '' %>>Vacation</option>
                                                    <option value="Commute" <%= typeof formData !== 'undefined' && formData.category === 'Commute' ? 'selected' : '' %>>Commute</option>
                                                </optgroup>
                                                <optgroup label="Entertainment & Hobbies">
                                                    <option value="Entertainment" <%= typeof formData !== 'undefined' && formData.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
                                                    <option value="Hobbies" <%= typeof formData !== 'undefined' && formData.category === 'Hobbies' ? 'selected' : '' %>>Hobbies</option>
                                                    <option value="Sports" <%= typeof formData !== 'undefined' && formData.category === 'Sports' ? 'selected' : '' %>>Sports</option>
                                                    <option value="Games" <%= typeof formData !== 'undefined' && formData.category === 'Games' ? 'selected' : '' %>>Games</option>
                                                    <option value="Movies" <%= typeof formData !== 'undefined' && formData.category === 'Movies' ? 'selected' : '' %>>Movies</option>
                                                </optgroup>
                                                <optgroup label="Technology">
                                                    <option value="Technology" <%= typeof formData !== 'undefined' && formData.category === 'Technology' ? 'selected' : '' %>>Technology</option>
                                                    <option value="Software" <%= typeof formData !== 'undefined' && formData.category === 'Software' ? 'selected' : '' %>>Software</option>
                                                    <option value="Apps" <%= typeof formData !== 'undefined' && formData.category === 'Apps' ? 'selected' : '' %>>Apps</option>
                                                    <option value="Hardware" <%= typeof formData !== 'undefined' && formData.category === 'Hardware' ? 'selected' : '' %>>Hardware</option>
                                                </optgroup>
                                                <optgroup label="Other">
                                                    <option value="Miscellaneous" <%= typeof formData !== 'undefined' && formData.category === 'Miscellaneous' ? 'selected' : '' %>>Miscellaneous</option>
                                                    <option value="Goals" <%= typeof formData !== 'undefined' && formData.category === 'Goals' ? 'selected' : '' %>>Goals</option>
                                                    <option value="Planning" <%= typeof formData !== 'undefined' && formData.category === 'Planning' ? 'selected' : '' %>>Planning</option>
                                                    <option value="Ideas" <%= typeof formData !== 'undefined' && formData.category === 'Ideas' ? 'selected' : '' %>>Ideas</option>
                                                </optgroup>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="priority" class="form-label">Priority</label>
                                            <select class="form-select" id="priority" name="priority">
                                                <option value="low" <%= typeof formData !== 'undefined' && formData.priority === 'low' ? 'selected' : '' %>>Low</option>
                                                <option value="medium" <%= typeof formData !== 'undefined' && formData.priority === 'medium' ? 'selected' : 'selected' %>>Medium</option>
                                                <option value="high" <%= typeof formData !== 'undefined' && formData.priority === 'high' ? 'selected' : '' %>>High</option>
                                                <option value="urgent" <%= typeof formData !== 'undefined' && formData.priority === 'urgent' ? 'selected' : '' %>>Urgent</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="due_date" class="form-label">Due Date</label>
                                            <input type="datetime-local" class="form-control" id="due_date" name="due_date" 
                                                   value="<%= typeof formData !== 'undefined' ? formData.due_date || '' : '' %>">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="total_amount" class="form-label">Amount</label>
                                            <input type="number" step="0.01" class="form-control" id="total_amount" name="total_amount" 
                                                   value="<%= typeof formData !== 'undefined' ? formData.total_amount || '0' : '0' %>"
                                                   placeholder="0.00">
                                        </div>
                                    </div>
                                </div>

                                <!-- Target Item Field (only for purchase type activities) -->
                                <div class="row" id="targetItemRow" style="display: none;">
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label for="target_item" class="form-label">Target Item</label>
                                            <input type="text" class="form-control" id="target_item" name="target_item" 
                                                   placeholder="What are you planning to buy?"
                                                   value="<%= typeof formData !== 'undefined' ? formData.target_item || '' : '' %>">
                                            <div class="form-text">Specify the item you're saving money for or planning to purchase.</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Timed Activity Fields (only for timed type activities) -->
                                <div class="row" id="timedFieldsRow" style="display: none;">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="start_time" class="form-label">Start Time</label>
                                            <input type="datetime-local" class="form-control" id="start_time" name="start_time" 
                                                   value="<%= typeof formData !== 'undefined' ? formData.start_time || '' : '' %>">
                                            <div class="form-text">When should this activity start?</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="end_time" class="form-label">End Time</label>
                                            <input type="datetime-local" class="form-control" id="end_time" name="end_time" 
                                                   value="<%= typeof formData !== 'undefined' ? formData.end_time || '' : '' %>">
                                            <div class="form-text">When should this activity end?</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/activities" class="btn btn-secondary">Cancel</a>
                                    <button type="submit" class="btn btn-primary">Create Activity</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="card-title mb-0">Activity Types</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <div class="type-info">
                                    <strong>General:</strong> Regular tasks and activities
                                </div>
                                <div class="type-info">
                                    <strong>Payment:</strong> Track payments and billing
                                </div>
                                <div class="type-info">
                                    <strong>Purchase:</strong> Shopping and procurement goals
                                </div>
                                <div class="type-info">
                                    <strong>Recurring:</strong> Repeating tasks and schedules
                                </div>
                                <div class="type-info">
                                    <strong>Timed Task:</strong> Time-bound activities with start and end times
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const typeSelect = document.getElementById('type');
    const targetItemRow = document.getElementById('targetItemRow');
    const targetItemInput = document.getElementById('target_item');
    const timedFieldsRow = document.getElementById('timedFieldsRow');
    const startTimeInput = document.getElementById('start_time');
    const endTimeInput = document.getElementById('end_time');
    const currentType = '<%= typeof formData !== "undefined" ? formData.type || "" : "" %>';

    function toggleTypeSpecificFields() {
        // Handle target item for purchase type
        if (typeSelect.value === 'purchase') {
            targetItemRow.style.display = 'block';
            targetItemInput.removeAttribute('disabled');
        } else {
            targetItemRow.style.display = 'none';
            targetItemInput.setAttribute('disabled', 'disabled');
            targetItemInput.value = ''; // Clear the value when hidden
        }

        // Handle timed fields for timed type
        if (typeSelect.value === 'timed') {
            timedFieldsRow.style.display = 'block';
            startTimeInput.removeAttribute('disabled');
            endTimeInput.removeAttribute('disabled');
            startTimeInput.setAttribute('required', 'required');
            endTimeInput.setAttribute('required', 'required');
        } else {
            timedFieldsRow.style.display = 'none';
            startTimeInput.setAttribute('disabled', 'disabled');
            endTimeInput.setAttribute('disabled', 'disabled');
            startTimeInput.removeAttribute('required');
            endTimeInput.removeAttribute('required');
            startTimeInput.value = ''; // Clear the values when hidden
            endTimeInput.value = '';
        }
    }

    // Initial state
    toggleTypeSpecificFields();

    // Listen for changes
    typeSelect.addEventListener('change', toggleTypeSpecificFields);

    // If there's existing form data, show appropriate fields
    if (currentType === 'purchase') {
        targetItemRow.style.display = 'block';
        targetItemInput.removeAttribute('disabled');
    }
    if (currentType === 'timed') {
        timedFieldsRow.style.display = 'block';
        startTimeInput.removeAttribute('disabled');
        endTimeInput.removeAttribute('disabled');
        startTimeInput.setAttribute('required', 'required');
        endTimeInput.setAttribute('required', 'required');
    }

    // Add validation for timed activities
    const form = document.querySelector('form');
    form.addEventListener('submit', function(e) {
        if (typeSelect.value === 'timed') {
            const startTime = new Date(startTimeInput.value);
            const endTime = new Date(endTimeInput.value);
            
            if (startTime >= endTime) {
                e.preventDefault();
                alert('End time must be after start time!');
                return false;
            }
        }
    });
});
</script>

<%- include('../partials/footer') %>
