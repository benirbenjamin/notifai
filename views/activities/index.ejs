<style>
/* Enhanced styles for timed activities */
.activity-card[data-end-time] .time-remaining {
    animation: pulse-subtle 2s infinite;
}

@keyframes pulse-subtle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

.activity-card.border-danger {
    border-width: 2px !important;
    animation: shake 0.5s ease-in-out;
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-2px); }
    75% { transform: translateX(2px); }
}

.overdue-task {
    animation: blink 1s infinite;
}

@keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0.5; }
}

/* Progress bar animations for time-based activities */
.progress-bar.bg-warning {
    animation: progress-pulse 2s infinite;
}

@keyframes progress-pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
}

/* Clickable card styles */
.clickable-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.clickable-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.15) !important;
}

.clickable-card:active {
    transform: translateY(0);
}

/* Prevent button clicks from triggering card click */
.clickable-card .btn,
.clickable-card button,
.clickable-card .dropdown,
.clickable-card .action-button {
    position: relative;
    z-index: 10;
}
</style>

<%- include('../partials/header') %>

