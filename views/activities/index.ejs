                        </optgroup>
                        <optgroup label="Financial">
                            <option value="Finance" <%= filters.category === 'Finance' ? 'selected' : '' %>>Finance</option>
                            <option value="Banking" <%= filters.category === 'Banking' ? 'selected' : '' %>>Banking</option>
                            <option value="Investments" <%= filters.category === 'Investments' ? 'selected' : '' %>>Investments</option>
                            <option value="Bills" <%= filters.category === 'Bills' ? 'selected' : '' %>>Bills</option>
                            <option value="Taxes" <%= filters.category === 'Taxes' ? 'selected' : '' %>>Taxes</option>
                        </optgroup>
                        <optgroup label="Learning & Development">
                            <option value="Education" <%= filters.category === 'Education' ? 'selected' : '' %>>Education</option>
                            <option value="Learning" <%= filters.category === 'Learning' ? 'selected' : '' %>>Learning</option>
                            <option value="Courses" <%= filters.category === 'Courses' ? 'selected' : '' %>>Courses</option>
                            <option value="Skills" <%= filters.category === 'Skills' ? 'selected' : '' %>>Skills</option>
                            <option value="Reading" <%= filters.category === 'Reading' ? 'selected' : '' %>>Reading</option>
                        </optgroup>
                        <optgroup label="Daily Tasks">
                            <option value="Shopping" <%= filters.category === 'Shopping' ? 'selected' : '' %>>Shopping</option>
                            <option value="Errands" <%= filters.category === 'Errands' ? 'selected' : '' %>>Errands</option>
                            <option value="Household" <%= filters.category === 'Household' ? 'selected' : '' %>>Household</option>
                            <option value="Chores" <%= filters.category === 'Chores' ? 'selected' : '' %>>Chores</option>
