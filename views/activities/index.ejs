                        </optgroup>
                        <optgroup label="Travel & Transportation">
                            <option value="Travel" <%= filters.category === 'Travel' ? 'selected' : '' %>>Travel</option>
                            <option value="Transportation" <%= filters.category === 'Transportation' ? 'selected' : '' %>>Transportation</option>
                            <option value="Vacation" <%= filters.category === 'Vacation' ? 'selected' : '' %>>Vacation</option>
                            <option value="Commute" <%= filters.category === 'Commute' ? 'selected' : '' %>>Commute</option>
                        </optgroup>
                        <optgroup label="Entertainment & Hobbies">
                            <option value="Entertainment" <%= filters.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
                            <option value="Hobbies" <%= filters.category === 'Hobbies' ? 'selected' : '' %>>Hobbies</option>
                            <option value="Sports" <%= filters.category === 'Sports' ? 'selected' : '' %>>Sports</option>
                            <option value="Games" <%= filters.category === 'Games' ? 'selected' : '' %>>Games</option>
                            <option value="Movies" <%= filters.category === 'Movies' ? 'selected' : '' %>>Movies</option>
                        </optgroup>
                        <optgroup label="Technology">
                            <option value="Technology" <%= filters.category === 'Technology' ? 'selected' : '' %>>Technology</option>
                            <option value="Software" <%= filters.category === 'Software' ? 'selected' : '' %>>Software</option>
                            <option value="Apps" <%= filters.category === 'Apps' ? 'selected' : '' %>>Apps</option>
                            <option value="Hardware" <%= filters.category === 'Hardware' ? 'selected' : '' %>>Hardware</option>
                        </optgroup>
                        <optgroup label="Other">
                            <option value="Miscellaneous" <%= filters.category === 'Miscellaneous' ? 'selected' : '' %>>Miscellaneous</option>
                            <option value="Goals" <%= filters.category === 'Goals' ? 'selected' : '' %>>Goals</option>
                            <option value="Planning" <%= filters.category === 'Planning' ? 'selected' : '' %>>Planning</option>
                            <option value="Ideas" <%= filters.category === 'Ideas' ? 'selected' : '' %>>Ideas</option>
                        </optgroup>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Priority</label>
                    <select class="form-select" name="priority">
                        <option value="">All Priorities</option>
