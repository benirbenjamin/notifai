/**
 * Daily Notification Settings and Test Page
 */

<%- include('../partials/header') %>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">Daily Notifications</h1>
                    <p class="text-muted mb-0">Test and manage your daily task summary notifications</p>
                </div>
            </div>

            <!-- Notification Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">📅 How Daily Notifications Work</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>📧 When you receive notifications:</h6>
                            <ul class="list-unstyled">
                                <li>🕗 <strong>Daily at 8:00 PM</strong> - Task summary</li>
                                <li>⏰ <strong>Hourly</strong> - Individual task reminders</li>
                                <li>🚨 <strong>Immediate</strong> - Critical overdue alerts</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>📋 What gets included:</h6>
                            <ul class="list-unstyled">
                                <li>🚨 <strong>Overdue tasks</strong> - Past due date</li>
                                <li>⏰ <strong>Due today</strong> - Must complete today</li>
                                <li>📋 <strong>Due tomorrow</strong> - Plan ahead</li>
                                <li>📅 <strong>Due this week</strong> - Upcoming tasks</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Test Notification -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">🧪 Test Daily Notification</h5>
                </div>
                <div class="card-body">
                    <p>Send yourself a test daily notification to see what it looks like:</p>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <button id="testDailyBtn" class="btn btn-primary btn-lg w-100 mb-3">
                                <i class="bi bi-send me-2"></i>Send Test Notification
                            </button>
                        </div>
                        <div class="col-md-6">
                            <button id="previewBtn" class="btn btn-outline-info btn-lg w-100 mb-3">
                                <i class="bi bi-eye me-2"></i>Preview What You'd Get
                            </button>
                        </div>
                    </div>
                    
                    <div id="testResult" class="alert" style="display: none;"></div>
                </div>
            </div>

            <!-- Preview Results -->
            <div id="previewCard" class="card mb-4" style="display: none;">
                <div class="card-header">
                    <h5 class="mb-0">👀 Notification Preview</h5>
                </div>
                <div class="card-body">
                    <div id="previewContent"></div>
                </div>
            </div>

            <!-- Current Notification Settings -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">⚙️ Your Notification Settings</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="emailNotifications" 
                                       <%= user.email_notifications ? 'checked' : '' %>>
                                <label class="form-check-label" for="emailNotifications">
                                    <i class="bi bi-envelope me-2"></i>Email Notifications
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="pushNotifications" 
                                       <%= user.push_notifications ? 'checked' : '' %>>
                                <label class="form-check-label" for="pushNotifications">
                                    <i class="bi bi-bell me-2"></i>Push Notifications
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <button id="saveSettingsBtn" class="btn btn-success">
                        <i class="bi bi-check-circle me-2"></i>Save Settings
                    </button>
                </div>
            </div>

            <!-- Schedule Information -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📅 Notification Schedule</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Notification Type</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>8:00 PM Daily</strong></td>
                                    <td><span class="badge bg-primary">Daily Summary</span></td>
                                    <td>Complete overview of all your tasks for tomorrow and overdue items</td>
                                </tr>
                                <tr>
                                    <td><strong>Every Hour</strong></td>
                                    <td><span class="badge bg-warning">Task Reminders</span></td>
                                    <td>Individual reminders for tasks due soon</td>
                                </tr>
                                <tr>
                                    <td><strong>Immediate</strong></td>
                                    <td><span class="badge bg-danger">Overdue Alerts</span></td>
                                    <td>Urgent notifications for tasks that just became overdue</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const testDailyBtn = document.getElementById('testDailyBtn');
    const previewBtn = document.getElementById('previewBtn');
    const saveSettingsBtn = document.getElementById('saveSettingsBtn');
    const testResult = document.getElementById('testResult');
    const previewCard = document.getElementById('previewCard');
    const previewContent = document.getElementById('previewContent');

    // Test daily notification
    testDailyBtn.addEventListener('click', async function() {
        const originalText = this.innerHTML;
        this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Sending...';
        this.disabled = true;

        try {
            const response = await fetch('/daily-notifications/test-daily', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.success) {
                showAlert(data.message, 'success');
            } else {
                showAlert(data.error || 'Failed to send test notification', 'danger');
            }
        } catch (error) {
            console.error('Error:', error);
            showAlert('Failed to send test notification', 'danger');
        } finally {
            this.innerHTML = originalText;
            this.disabled = false;
        }
    });

    // Preview notification
    previewBtn.addEventListener('click', async function() {
        const originalText = this.innerHTML;
        this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Loading...';
        this.disabled = true;

        try {
            const response = await fetch('/daily-notifications/preview-daily');
            const data = await response.json();

            if (data.success) {
                showPreview(data.preview);
                previewCard.style.display = 'block';
            } else {
                showAlert(data.error || 'Failed to load preview', 'danger');
            }
        } catch (error) {
            console.error('Error:', error);
            showAlert('Failed to load preview', 'danger');
        } finally {
            this.innerHTML = originalText;
            this.disabled = false;
        }
    });

    // Save settings
    saveSettingsBtn.addEventListener('click', async function() {
        const emailNotifications = document.getElementById('emailNotifications').checked;
        const pushNotifications = document.getElementById('pushNotifications').checked;

        const originalText = this.innerHTML;
        this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Saving...';
        this.disabled = true;

        try {
            const response = await fetch('/dashboard/profile', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    email_notifications: emailNotifications,
                    push_notifications: pushNotifications
                })
            });

            const data = await response.json();

            if (data.success) {
                showAlert('Settings saved successfully!', 'success');
            } else {
                showAlert(data.error || 'Failed to save settings', 'danger');
            }
        } catch (error) {
            console.error('Error:', error);
            showAlert('Failed to save settings', 'danger');
        } finally {
            this.innerHTML = originalText;
            this.disabled = false;
        }
    });

    function showAlert(message, type) {
        testResult.className = `alert alert-${type}`;
        testResult.innerHTML = message;
        testResult.style.display = 'block';
        
        setTimeout(() => {
            testResult.style.display = 'none';
        }, 5000);
    }

    function showPreview(preview) {
        let html = '';

        if (preview.wouldSendNotification) {
            html += `<div class="alert alert-info"><strong>📧 You would receive a notification</strong> because you have ${preview.totalActivities} activities needing attention.</div>`;
            
            html += '<div class="row">';
            
            if (preview.categories.overdue > 0) {
                html += `
                    <div class="col-md-6 mb-3">
                        <div class="card border-danger">
                            <div class="card-body text-center">
                                <h5 class="text-danger">🚨 ${preview.categories.overdue}</h5>
                                <p class="mb-0">Overdue Tasks</p>
                            </div>
                        </div>
                    </div>
                `;
            }
            
            if (preview.categories.dueToday > 0) {
                html += `
                    <div class="col-md-6 mb-3">
                        <div class="card border-warning">
                            <div class="card-body text-center">
                                <h5 class="text-warning">⏰ ${preview.categories.dueToday}</h5>
                                <p class="mb-0">Due Today</p>
                            </div>
                        </div>
                    </div>
                `;
            }
            
            if (preview.categories.dueTomorrow > 0) {
                html += `
                    <div class="col-md-6 mb-3">
                        <div class="card border-info">
                            <div class="card-body text-center">
                                <h5 class="text-info">📋 ${preview.categories.dueTomorrow}</h5>
                                <p class="mb-0">Due Tomorrow</p>
                            </div>
                        </div>
                    </div>
                `;
            }
            
            if (preview.categories.dueThisWeek > 0) {
                html += `
                    <div class="col-md-6 mb-3">
                        <div class="card border-success">
                            <div class="card-body text-center">
                                <h5 class="text-success">📅 ${preview.categories.dueThisWeek}</h5>
                                <p class="mb-0">Due This Week</p>
                            </div>
                        </div>
                    </div>
                `;
            }
            
            html += '</div>';

            // Show sample tasks
            if (preview.activities.overdue.length > 0) {
                html += `
                    <div class="mt-3">
                        <h6 class="text-danger">🚨 Overdue Tasks:</h6>
                        <ul class="list-group list-group-flush">
                            ${preview.activities.overdue.slice(0, 3).map(activity => 
                                `<li class="list-group-item px-0">${activity.title}</li>`
                            ).join('')}
                            ${preview.activities.overdue.length > 3 ? `<li class="list-group-item px-0 text-muted"><em>... and ${preview.activities.overdue.length - 3} more</em></li>` : ''}
                        </ul>
                    </div>
                `;
            }

        } else {
            html += '<div class="alert alert-success"><strong>📭 No notification would be sent</strong> because you have no urgent tasks needing attention.</div>';
        }

        previewContent.innerHTML = html;
    }
});
</script>

<%- include('../partials/footer') %>
