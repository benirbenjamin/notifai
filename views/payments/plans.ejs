<!-- Currency Data Script -->
<script type="application/json" id="currencyData">
<% if (typeof currencyData !== 'undefined') { %>
  <%- JSON.stringify(currencyData) %>
<% } else { %>
  {}
<% } %>
</script>

<script>
let selectedPlan = null;
let currentCurrency = 'USD';
let currencyData = {};

// Load currency data from JSON script
try {
  const currencyDataElement = document.getElementById('currencyData');
  if (currencyDataElement) {
    currencyData = JSON.parse(currencyDataElement.textContent);
  }
} catch (e) {
  console.warn('Failed to load currency data:', e);
}

// Currency conversion functions
async function updatePricing() {
  const selectedCurrency = document.getElementById('currencySelect').value;
  currentCurrency = selectedCurrency;
  
  console.log('🔄 Updating pricing for currency:', selectedCurrency);
  
  // Update plan prices
  document.querySelectorAll('.plan-price').forEach(async (priceElement) => {
    const basePrice = parseFloat(priceElement.getAttribute('data-base-price')) || 0;
    
    if (basePrice === 0) {
      priceElement.textContent = 'Free';
      return;
    }
    
    if (selectedCurrency === 'USD') {
      priceElement.textContent = `$${basePrice.toFixed(2)}`;
    } else {
      // Get converted price from backend
      try {
        const response = await fetch(`/payments/api/currency/${selectedCurrency}?amount=${basePrice}`);
        const data = await response.json();
        if (data.success) {
          priceElement.textContent = data.conversion.formatted;
        } else {
          priceElement.textContent = `${basePrice} ${selectedCurrency}`;
        }
      } catch (error) {
        console.error('Error converting currency:', error);
        priceElement.textContent = `${basePrice} ${selectedCurrency}`;
      }
    }
  });
  
  // Update button text
  document.querySelectorAll('.button-text').forEach(async (buttonText) => {
    const button = buttonText.closest('.subscribe-btn');
    const basePrice = parseFloat(button.getAttribute('data-plan-price')) || 0;
    
    if (basePrice > 0) {
      if (selectedCurrency === 'USD') {
        buttonText.textContent = `Get Lifetime Access - $${basePrice.toFixed(2)}`;
      } else {
        try {
          const response = await fetch(`/payments/api/currency/${selectedCurrency}?amount=${basePrice}`);
          const data = await response.json();
          if (data.success) {
            buttonText.textContent = `Get Lifetime Access - ${data.conversion.formatted}`;
          } else {
            buttonText.textContent = `Get Lifetime Access - ${basePrice} ${selectedCurrency}`;
          }
        } catch (error) {
          console.error('Error converting currency for button:', error);
          buttonText.textContent = `Get Lifetime Access - ${basePrice} ${selectedCurrency}`;
        }
      }
    }
  });
}

function formatCurrency(amount, currency) {
  if (!currencyData[currency]) return `${amount} ${currency}`;
  
  const info = currencyData[currency];
  let formatOptions = {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  };
  
  // Some currencies don't typically show decimals
  if (['UGX', 'RWF'].includes(currency)) {
    formatOptions.minimumFractionDigits = 0;
    formatOptions.maximumFractionDigits = 0;
    amount = Math.round(amount);
  }
  
  const formattedAmount = amount.toLocaleString('en-US', formatOptions);
  return `${info.symbol}${formattedAmount}`;
}

// Check if everything is loaded
window.addEventListener('DOMContentLoaded', function() {
  console.log('DOM loaded');
  
  // Debug currency data and dropdown
  console.log('💰 CURRENCY FRONTEND DEBUG:');
  console.log('currencyData loaded:', currencyData);
  console.log('currencyData keys:', Object.keys(currencyData));
  
  const currencySelect = document.getElementById('currencySelect');
  if (currencySelect) {
    console.log('🔎 Currency select found with options:');
    Array.from(currencySelect.options).forEach((option, index) => {
      console.log(`  ${index}: ${option.value} (${option.text}) - selected: ${option.selected}`);
    });
    console.log('Default selected currency:', currencySelect.value);
    
    // Test currency change
    currencySelect.addEventListener('change', function() {
      console.log('💱 Currency changed to:', this.value);
      updatePricing();
    });
    
    // Manual test - set to RWF to see if it works
    setTimeout(() => {
      console.log('🧪 Testing: Setting currency to RWF manually');
      currencySelect.value = 'RWF';
      console.log('After setting to RWF, current value:', currencySelect.value);
    }, 2000);
  } else {
    console.error('❌ Currency select element not found!');
  }
  
  // Add subscribe button handlers
  const subscribeButtons = document.querySelectorAll('.subscribe-btn');
  subscribeButtons.forEach(button => {
    button.addEventListener('click', function(event) {
      // Prevent any default form submission
      event.preventDefault();
      event.stopPropagation();
      
      const planId = this.getAttribute('data-plan-id');
      const planName = this.getAttribute('data-plan-name');
      const planPrice = this.getAttribute('data-plan-price');
      
      console.log('Subscribe button clicked:', { planId, planName, planPrice });
      subscribeToPlan(planId, planName, planPrice);
    });
  });
});

function subscribeToPlan(planId, planName, planPrice) {
  console.log('subscribeToPlan called with:', { planId, planName, planPrice });
  
  selectedPlan = { id: planId, name: planName, price: parseFloat(planPrice) };
  
  console.log('selectedPlan set to:', selectedPlan);
  
  // IMMEDIATE CURRENCY CHECK - before any delay
  const currencySelectElement = document.getElementById('currencySelect');
  console.log('🚨 IMMEDIATE CURRENCY CHECK:');
  console.log('Currency select element found?', !!currencySelectElement);
  if (currencySelectElement) {
    console.log('Current selected value:', currencySelectElement.value);
    console.log('Current selected index:', currencySelectElement.selectedIndex);
    console.log('Selected option text:', currencySelectElement.options[currencySelectElement.selectedIndex]?.text);
  }
  
  // Add small delay to prevent double-clicking issues
  setTimeout(() => {
    // Get the selected currency from the dropdown
    const selectedCurrency = currencySelectElement ? currencySelectElement.value : 'USD';
    
    console.log('🔍 CURRENCY SELECTION DEBUG:');
    console.log('Currency select element:', currencySelectElement);
    console.log('Currency select element exists?', !!currencySelectElement);
    console.log('Selected currency value:', selectedCurrency);
    console.log('All options in select:');
    if (currencySelectElement) {
      Array.from(currencySelectElement.options).forEach((option, index) => {
        console.log(`  ${index}: ${option.value} (${option.text}) - selected: ${option.selected}`);
      });
    }
    
    console.log('Using selected currency:', selectedCurrency);
    
    // Initiate payment with the selected currency
    initiatePayment(selectedCurrency);
  }, 100);
}

function initiatePayment(currency) {
  console.log('=== FRONTEND PAYMENT DEBUG START ===');
  console.log('initiatePayment called with currency parameter:', currency);
  console.log('typeof currency:', typeof currency);
  console.log('Initiating payment for:', selectedPlan, 'in currency:', currency);
  
  // Double-check the currency selection
  const currencySelectElement = document.getElementById('currencySelect');
  const currentSelectedCurrency = currencySelectElement ? currencySelectElement.value : 'USD';
  console.log('Double-check - current currency in dropdown:', currentSelectedCurrency);
  
  // Use the current dropdown value as the source of truth
  const finalCurrency = currentSelectedCurrency || currency || 'USD';
  console.log('Final currency to use:', finalCurrency);
  
  if (!selectedPlan) {
    alert('Please select a plan first');
    return;
  }
  
  // Create JSON data instead of FormData
  const paymentData = {
    planId: selectedPlan.id,
    duration: 'lifetime', // Since it's a lifetime plan
    currency: finalCurrency,
    amount: selectedPlan.price
  };
  
  console.log('Payment data being sent:', paymentData);
  console.log('=== FRONTEND PAYMENT DEBUG END ===');
  
  // Submit to payment route with JSON
  fetch('/payments/subscribe?v=' + Date.now(), {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(paymentData)
  })
  .then(response => {
    console.log('Payment response status:', response.status);
    return response.json();
  })
  .then(data => {
    console.log('Payment response data:', data);
    if (data.success) {
      // Redirect to Flutterwave
      window.location.href = data.paymentUrl;
    } else {
      alert('Payment initialization failed: ' + data.message);
    }
  })
  .catch(error => {
    console.error('Payment error:', error);
    alert('An error occurred. Please try again.');
  });
}

function updatePriceDisplay() {
  console.log('updatePriceDisplay called');
  
  if (!selectedPlan) {
    console.log('No selectedPlan, returning');
    return;
  }
  
  console.log('selectedPlan:', selectedPlan);
  
  const durationElement = document.getElementById('duration');
  const currencyElement = document.getElementById('currency');
  
  if (!durationElement || !currencyElement) {
    console.error('Duration or currency element not found');
    return;
  }
  
  const duration = parseInt(durationElement.value);
  const currency = currencyElement.value;
  
  console.log('Duration:', duration, 'Currency:', currency);
  
  // Update duration display
  const durationText = duration === 1 ? '1 month' : `${duration} months`;
  document.getElementById('selectedDuration').textContent = durationText;
  
  // Calculate total in USD first
  const monthlyUSD = selectedPlan.price;
  const totalUSD = monthlyUSD * duration;
  
  if (currency === 'USD') {
    document.getElementById('monthlyPrice').textContent = `$${monthlyUSD.toFixed(2)}`;
    document.getElementById('totalPrice').textContent = `$${totalUSD.toFixed(2)}`;
    document.getElementById('exchangeInfo').style.display = 'none';
  } else {
    // Convert to RWF
    fetch(`/payments/api/convert?amount=${monthlyUSD}&from=USD&to=RWF`)
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          const monthlyRWF = data.convertedAmount;
          const totalRWF = monthlyRWF * duration;
          currentExchangeRate = data.exchangeRate;
          
          document.getElementById('monthlyPrice').textContent = `${monthlyRWF.toLocaleString()} RWF`;
          document.getElementById('totalPrice').textContent = `${totalRWF.toLocaleString()} RWF`;
          document.getElementById('exchangeRate').textContent = `1 USD = ${data.exchangeRate} RWF`;
          document.getElementById('exchangeInfo').style.display = 'block';
        }
      })
      .catch(error => {
        console.error('Currency conversion failed:', error);
        // Fallback to USD
        document.getElementById('currency').value = 'USD';
        updatePriceDisplay();
      });
  }
}

// Event listeners
document.getElementById('duration').addEventListener('change', updatePriceDisplay);
document.getElementById('currency').addEventListener('change', updatePriceDisplay);

document.getElementById('confirmPayment').addEventListener('click', function() {
  if (!selectedPlan) return;
  
  const duration = document.getElementById('duration').value;
  const currency = document.getElementById('currency').value;
  
  // Show loading state
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
  
  // Create JSON data instead of FormData
  const paymentData = {
    planId: selectedPlan.id,
    duration: duration,
    currency: currentCurrency,
    amount: selectedPlan.price
  };
  
  // Submit to payment route with JSON
  fetch('/payments/subscribe', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(paymentData)
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Redirect to Flutterwave
      window.location.href = data.paymentUrl;
    } else {
      alert('Payment initialization failed: ' + data.message);
      // Reset button
      this.disabled = false;
      this.innerHTML = 'Proceed to Payment';
    }
  })
  .catch(error => {
    console.error('Payment error:', error);
    alert('An error occurred. Please try again.');
    // Reset button
    this.disabled = false;
    this.innerHTML = 'Proceed to Payment';
  });
});

// Handle free plan switch
function switchToFreePlan() {
  if (confirm('Are you sure you want to switch to the free plan? You will lose access to premium features.')) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/payments/switch-to-free';
    document.body.appendChild(form);
    form.submit();
  }
}

// Enable push notifications
function enableNotifications() {
  if ('Notification' in window && 'serviceWorker' in navigator) {
    // Check if notification manager exists
    if (window.notificationManager && typeof window.notificationManager.requestNotificationPermission === 'function') {
      window.notificationManager.requestNotificationPermission();
    } else {
      // Fallback: basic notification permission
      Notification.requestPermission().then(permission => {
        if (permission === 'granted') {
          alert('Notifications enabled! You will receive push notifications.');
        } else {
          alert('Notifications were not enabled. You can enable them later in your browser settings.');
        }
      });
    }
  } else {
    alert('Push notifications are not supported in this browser.');
  }
}
</script>

<%- include('../partials/footer') %>
