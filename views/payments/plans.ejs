<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
          <i class="bi bi-gem me-2"></i>Subscription Plans
        </h1>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Plans</li>
          </ol>
        </nav>
      </div>
    </div>
  </div>

  <!-- Success/Error Messages -->
  <% if (typeof query !== 'undefined') { %>
    <% if (query.success === 'switched_to_free') { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>Successfully switched to the free plan!
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } else if (query.success === 'downgraded') { %>
      <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle me-2"></i>Your subscription has been cancelled and you've been downgraded to the free plan.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } else if (query.error === 'failed_to_switch') { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>Failed to switch to free plan. Please try again.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
  <% } %>

  <!-- Current Plan Status -->
  <% if (currentPlan) { %>
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-info">
        <h5 class="alert-heading">
          <i class="bi bi-info-circle me-2"></i>Current Plan
        </h5>
        <p class="mb-0">
          You are currently on the <strong><%= currentPlan.name %></strong> plan.
          <% if (currentPlan.subscription_end) { %>
            Your subscription will expire on <%= new Date(currentPlan.subscription_end).toLocaleDateString() %>.
          <% } %>
        </p>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Currency Selection -->
  <div class="row justify-content-center mb-4">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title text-center mb-3">
            <i class="bi bi-currency-exchange me-2"></i>Choose Your Currency
          </h5>
          <div class="row">
            <div class="col-md-6 mx-auto">
              <select class="form-select" id="currencySelect">
                <% if (typeof currencyData !== 'undefined' && currencyData && Object.keys(currencyData).length > 0) { %>
                  <% Object.entries(currencyData).forEach(([code, data]) => { %>
                    <option value="<%= code %>" <%= code === 'USD' ? 'selected' : '' %>>
                      <%= data.name %> (<%= data.symbol %>) - <%= data.formatted %>
                    </option>
                  <% }); %>
                <% } else { %>
                  <!-- Fallback currencies that match backend validation -->
                  <option value="USD" selected>US Dollar ($) - $10.00</option>
                  <option value="NGN">Nigerian Naira (₦) - ₦15,000</option>
                  <option value="KES">Kenyan Shilling (KSh) - KSh1,300</option>
                  <option value="UGX">Ugandan Shilling (USh) - USh37,000</option>
                  <option value="RWF">Rwandan Franc (RWF) - RWF13,000</option>
                  <option value="GHS">Ghanaian Cedi (₵) - ₵120</option>
                  <option value="ZAR">South African Rand (R) - R180</option>
                  <option value="EUR">Euro (€) - €8.50</option>
                  <option value="GBP">British Pound (£) - £7.30</option>
                <% } %>
              </select>
              <small class="form-text text-muted text-center d-block mt-2">
                <i class="bi bi-info-circle me-1"></i>
                Prices are converted in real-time using current exchange rates
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Plans Grid -->
  <div class="row justify-content-center">
    <% plans.forEach(plan => { %>
    <div class="col-md-6 col-lg-5 mb-4">
      <div class="card h-100 <%= currentPlan && currentPlan.plan_id === plan.id ? 'border-primary' : '' %>">
        <div class="card-header text-center">
          <h3 class="card-title mb-0"><%= plan.name %></h3>
          <% if (currentPlan && currentPlan.plan_id === plan.id) { %>
            <span class="badge bg-primary mt-2">Current Plan</span>
          <% } %>
        </div>
        
        <div class="card-body text-center">
          <div class="display-4 fw-bold text-primary mb-3">
            <% if (plan.price == 0) { %>
              <span class="plan-price">Free</span>
            <% } else { %>
              <span class="plan-price" data-base-price="<%= plan.price %>">$<%= plan.price %></span>
              <% if (plan.is_lifetime) { %>
                <small class="text-muted fs-6">one-time</small>
              <% } else { %>
                <small class="text-muted fs-6">/month</small>
              <% } %>
            <% } %>
          </div>
          
          <p class="text-muted mb-4"><%= plan.description %></p>
          
          <ul class="list-unstyled mb-4">
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              <%= plan.max_activities >= 999999 ? 'Unlimited' : plan.max_activities %> Activities
            </li>
            <li class="mb-2">
              <i class="bi bi-<%= plan.has_push_notifications ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
              Push Notifications
            </li>
            <li class="mb-2">
              <i class="bi bi-<%= plan.has_attachments ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
              File Attachments
            </li>
            <li class="mb-2">
              <i class="bi bi-<%= plan.has_recurring_tasks ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
              Recurring Tasks
            </li>
            <li class="mb-2">
              <i class="bi bi-<%= plan.has_categories ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
              Categories & Tags
            </li>
            <li class="mb-2">
              <i class="bi bi-<%= plan.has_priority_levels ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
              Priority Levels
            </li>
            <li class="mb-2">
              <i class="bi bi-<%= plan.has_advanced_progress ? 'check-circle text-success' : 'x-circle text-muted' %> me-2"></i>
              Advanced Progress Tracking
            </li>
          </ul>
        </div>
        <div class="card-footer">
          <% if (currentPlan && currentPlan.plan_id === plan.id) { %>
            <button class="btn btn-outline-primary w-100" disabled>
              <i class="bi bi-check-circle me-2"></i>Current Plan
            </button>
          <% } else if (plan.price == 0) { %>
            <button type="button" class="btn btn-secondary w-100" onclick="switchToFreePlan()">
              <i class="bi bi-arrow-down-circle me-2"></i>Switch to Free
            </button>
          <% } else { %>
            <button class="btn btn-warning w-100 subscribe-btn fw-bold" 
                    data-plan-id="<%= plan.id %>" 
                    data-plan-name="<%= plan.name %>" 
                    data-plan-price="<%= plan.price %>">
              <i class="bi bi-gem me-2"></i>
              <% if (currentPlan && currentPlan.plan_id === 1) { %>
                <span class="button-text">Get Lifetime Access - $<%= plan.price %></span>
              <% } else { %>
                <span class="button-text">Get Lifetime Access</span>
              <% } %>
            </button>
          <% } %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Payment Security Notice -->
  <div class="row mt-5">
    <div class="col-12">
      <div class="alert alert-light">
        <div class="d-flex align-items-center">
          <i class="bi bi-shield-check text-success me-3 fs-3"></i>
          <div>
            <h6 class="mb-1">Secure Payment Processing</h6>
            <small class="text-muted">
              All payments are securely processed through Flutterwave. 
              We don't store your payment information.
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Test Push Notifications -->
  <div class="row mt-3">
    <div class="col-12">
      <div class="alert alert-info">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="mb-1">
              <i class="bi bi-bell me-2"></i>Test Push Notifications
            </h6>
            <small class="text-muted">
              Enable notifications to receive updates about your activities and payments.
            </small>
          </div>
          <button class="btn btn-primary btn-sm" onclick="enableNotifications()">
            <i class="bi bi-bell me-1"></i>Enable Notifications
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

