<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
          <i class="bi bi-clock-history me-2"></i>Payment History
        </h1>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Payment History</li>
          </ol>
        </nav>
      </div>
    </div>
  </div>

  <% if (typeof subscriptions !== 'undefined' && subscriptions && subscriptions.length > 0) { %>
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="bi bi-receipt me-2"></i>Subscription History
          </h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Plan</th>
                  <th>Amount</th>
                  <th>Duration</th>
                  <th>Start Date</th>
                  <th>End Date</th>
                  <th>Status</th>
                  <th>Transaction ID</th>
                </tr>
              </thead>
              <tbody>
                <% subscriptions.forEach(subscription => { %>
                <tr>
                  <td>
                    <strong><%= subscription.plan_name || 'Unknown Plan' %></strong>
                  </td>
                  <td>
                    <span class="text-success fw-bold">$<%= subscription.amount %></span>
                  </td>
                  <td>
                    <%= subscription.duration_months %> month<%= subscription.duration_months !== 1 ? 's' : '' %>
                  </td>
                  <td>
                    <%= new Date(subscription.start_date).toLocaleDateString() %>
                  </td>
                  <td>
                    <%= new Date(subscription.end_date).toLocaleDateString() %>
                  </td>
                  <td>
                    <% if (subscription.status === 'active') { %>
                      <span class="badge bg-success">Active</span>
                    <% } else if (subscription.status === 'expired') { %>
                      <span class="badge bg-warning">Expired</span>
                    <% } else if (subscription.status === 'cancelled') { %>
                      <span class="badge bg-danger">Cancelled</span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= subscription.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <% if (subscription.flutterwave_transaction_id) { %>
                      <small class="text-muted">
                        <%= subscription.flutterwave_transaction_id.substring(0, 12) %>...
                      </small>
                    <% } else { %>
                      <small class="text-muted">N/A</small>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body text-center py-5">
          <div class="mb-4">
            <i class="bi bi-receipt" style="font-size: 3rem; color: #6c757d;"></i>
          </div>
          <h3 class="text-muted">No Payment History</h3>
          <p class="text-muted mb-4">
            You haven't made any payments yet. Upgrade your plan to access premium features.
          </p>
          <a href="/payments/plans" class="btn btn-primary">
            <i class="bi bi-gem me-2"></i>View Plans
          </a>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Current Plan Info -->
  <% if (typeof userPlan !== 'undefined' && userPlan) { %>
  <div class="row mt-4">
    <div class="col-12">
      <div class="card bg-light">
        <div class="card-body">
          <h5 class="card-title">
            <i class="bi bi-gem me-2"></i>Current Plan
          </h5>
          <div class="row">
            <div class="col-md-6">
              <p class="mb-1"><strong>Plan:</strong> <%= userPlan.name %></p>
              <p class="mb-1"><strong>Activities Limit:</strong> 
                <%= userPlan.max_activities >= 999999 ? 'Unlimited' : userPlan.max_activities %>
              </p>
            </div>
            <div class="col-md-6">
              <% if (userPlan.subscription_end) { %>
                <p class="mb-1"><strong>Expires:</strong> 
                  <%= new Date(userPlan.subscription_end).toLocaleDateString() %>
                </p>
              <% } %>
            </div>
          </div>
          <div class="mt-3">
            <a href="/payments/plans" class="btn btn-outline-primary btn-sm">
              <i class="bi bi-arrow-up-circle me-1"></i>Upgrade Plan
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>

<style>
.table th {
  border-top: none;
  font-weight: 600;
  color: #495057;
}

.card {
  box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  border: 1px solid rgba(0, 0, 0, 0.125);
}

.badge {
  font-size: 0.75em;
}
</style>

<%- include('../partials/footer') %>
