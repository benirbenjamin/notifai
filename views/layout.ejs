<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - <%= appName %></title>
    
    <!-- Meta tags for PWA -->
    <meta name="description" content="Smart Activity Manager with Advanced Features">
    <meta name="theme-color" content="#007bff">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="<%= appName %>">
    
    <!-- PWA manifest -->
    <link rel="manifest" href="/manifest.json">
    
    <!-- Favicon and Icons -->
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="shortcut icon" type="image/png" href="/images/favicon.png">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo.png">
    <link rel="mask-icon" href="/images/icon.svg" color="#6366f1">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Custom CSS -->
    <link href="/css/app.css?v=<%= Date.now() %>" rel="stylesheet">
    
    <!-- Additional page-specific styles -->
    <% if (typeof styles !== 'undefined') { %>
        <% styles.forEach(style => { %>
            <link href="<%= style %>" rel="stylesheet">
        <% }) %>
    <% } %>
</head>
<body>
    <!-- Navigation -->
    <% if (user) { %>
        <%- include('partials/navbar') %>
    <% } %>
    
    <!-- Main Content -->
    <main class="<%= user ? 'main-content' : 'landing-main' %>">
        <!-- Alert Messages -->
        <div class="container-fluid">
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            
            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <% errors.forEach(error => { %>
                        <div><%= error.msg %></div>
                    <% }) %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
        </div>
        
        <!-- Page Content -->
        <%- body %>
    </main>
    
    <!-- Bottom Navigation for Mobile -->
    <% if (user) { %>
        <%- include('partials/bottom-nav') %>
    <% } %>
    
    <!-- Footer -->
    <% if (!user) { %>
        <%- include('partials/footer') %>
    <% } %>
    
    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="loading-spinner d-none">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    
    <!-- Offline Banner -->
    <div id="offlineBanner" class="offline-banner d-none">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-wifi-off me-2"></i>
                        You're currently offline. Some features may be limited.
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Plan Limit Modal -->
    <div class="modal fade" id="planLimitModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Plan Limit Reached</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>You've reached the activity limit for your current plan. Upgrade to continue adding activities.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Later</button>
                    <a href="/payments/plans" class="btn btn-primary">Upgrade Now</a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Scripts -->
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- App JS -->
    <script src="/js/app.js?v=<%= Date.now() %>"></script>
    
    <!-- PWA Service Worker -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(registration => {
                        console.log('SW registered: ', registration);
                    })
                    .catch(registrationError => {
                        console.log('SW registration failed: ', registrationError);
                    });
            });
        }
    </script>
    
    <!-- Push Notifications -->
    <% if (user && userPlan && userPlan.has_push_notifications) { %>
        <script>
            // Add VAPID public key for push notifications
            window.VAPID_PUBLIC_KEY = '<%= process.env.VAPID_PUBLIC_KEY %>';
        </script>
        <script src="/js/push-notifications.js?v=<%= Date.now() %>"></script>
    <% } %>
    
    <!-- Additional page-specific scripts -->
    <% if (typeof scripts !== 'undefined') { %>
        <% scripts.forEach(script => { %>
            <script src="<%= script %>"></script>
        <% }) %>
    <% } %>
</body>
</html>
