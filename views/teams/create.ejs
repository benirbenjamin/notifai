<%- include('../partials/header') %>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">Create Team</h1>
                <a href="/teams" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to Teams
                </a>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Team Details</h5>
                        </div>
                        <div class="card-body">
                            <form action="/teams/create" method="POST">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Team Name *</label>
                                    <input type="text" class="form-control" id="name" name="name" 
                                           value="<%= typeof formData !== 'undefined' ? formData.name || '' : '' %>" 
                                           placeholder="Enter team name" required>
                                </div>

                                <div class="mb-3">
                                    <label for="description" class="form-label">Description</label>
                                    <textarea class="form-control" id="description" name="description" rows="3" 
                                              placeholder="Describe your team's purpose and goals"><%= typeof formData !== 'undefined' ? formData.description || '' : '' %></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="is_private" class="form-label">Privacy Setting *</label>
                                            <select class="form-select" id="is_private" name="is_private" required>
                                                <option value="false" <%= typeof formData !== 'undefined' && formData.is_private === 'false' ? 'selected' : '' %>>Public</option>
                                                <option value="true" <%= typeof formData !== 'undefined' && formData.is_private === 'true' ? 'selected' : 'selected' %>>Private</option>
                                            </select>
                                            <div class="form-text">
                                                Public teams can be discovered by anyone. Private teams require an invitation.
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="max_members" class="form-label">Maximum Members</label>
                                            <input type="number" class="form-control" id="max_members" name="max_members" 
                                                   value="<%= typeof formData !== 'undefined' ? formData.max_members || '10' : '10' %>" 
                                                   min="2" max="100">
                                            <div class="form-text">Leave empty for unlimited members.</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/teams" class="btn btn-secondary">Cancel</a>
                                    <button type="submit" class="btn btn-primary">Create Team</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="card-title mb-0">Team Benefits</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-3">
                                <div>
                                    <i class="bi bi-people-fill text-primary me-2"></i>
                                    <strong>Collaborate</strong><br>
                                    <small class="text-muted">Work together on activities and projects</small>
                                </div>
                                <div>
                                    <i class="bi bi-chat-fill text-success me-2"></i>
                                    <strong>Chat</strong><br>
                                    <small class="text-muted">Real-time team communication</small>
                                </div>
                                <div>
                                    <i class="bi bi-share-fill text-info me-2"></i>
                                    <strong>Share</strong><br>
                                    <small class="text-muted">Share activities and resources</small>
                                </div>
                                <div>
                                    <i class="bi bi-graph-up text-warning me-2"></i>
                                    <strong>Track Progress</strong><br>
                                    <small class="text-muted">Monitor team performance and goals</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
